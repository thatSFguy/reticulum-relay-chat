/rrc-hub
/rrc-hub.exe
/rrc-hub-*
/build/
/dist/
*.test
*.out
.idea/
.vscode/

# Local hub state — never commit the long-term identity or a live config.
# Both keys: the hub identity clients dial, and the lxmf.delivery
# notification identity beside it (v0.5.0). The second one is why this
# is a glob — a new sibling key must not need a new ignore rule to stay
# out of a public repo.
hub_identity*
/rrc-hub.toml
*.log

# The test clients' virtualenv and the identity files they create.
/venv/
/tools/venv/
*.identity

# Runtime state a running hub writes beside itself, at the default paths
# in rrc-hub.example.toml. peers.toml is the one that matters: it holds
# real users' public keys, nicknames and any mentions still waiting for
# them, and it appears the first time anybody connects.
/peers.toml
/rooms.toml
/klines.txt
/history/

# Agent / AI config files — local to the developer, not pushed.
AGENTS.md
AGENT.md
agents.md
agent.md
.claude/
.cursor/
CLAUDE.md
